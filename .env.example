# 로컬 테스트용 환경변수 예시. 실제 값을 채운 뒤 파일명을 .env로 바꾸세요.
# .env는 절대 git에 커밋하지 마세요.

# Claude API (콘텐츠 생성)
ANTHROPIC_API_KEY=

# Threads API (scripts/oauth_setup.py 실행 후 얻은 값)
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# Meta Developer 앱 정보 (oauth_setup.py / refresh_token.py 실행 시 필요)
THREADS_APP_ID=
THREADS_APP_SECRET=

# GitHub Secrets 자동 갱신용 (refresh_token.py, repo 시크릿 쓰기 권한 필요)
GH_PAT=
GITHUB_REPOSITORY=owner/repo
